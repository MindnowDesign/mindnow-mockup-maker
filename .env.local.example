# Firebase Web App configuration
# 1. Enable Firebase on your GCP project at https://console.firebase.google.com/
#    (Project: mindnow-mockup-maker — requires org admin if 403 on CLI)
# 2. Register a Web app in Firebase Console → Project settings → Your apps
# 3. Copy the config values below into .env.local
# 4. Deploy auth providers: npx firebase-tools@latest deploy --only auth
# 5. Add your app hostnames to Firebase Authentication → Settings → Authorized domains
#    (firebase deploy --only auth enables providers but does not reliably sync authorizedDomains)

NEXT_PUBLIC_FIREBASE_API_KEY=
# Local dev: add these in Google Cloud Console → OAuth client → Authorized redirect URIs:
#   http://localhost:3000/auth/google/callback
#   http://127.0.0.1:3000/auth/google/callback
# Local dev (http://localhost): leave blank — Google Sign-In uses GIS redirect to /auth/google/callback.
# Production (Vercel): leave blank — uses your app hostname with the /__/auth proxy.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mindnow-mockup-maker-54797
# Public OAuth web client ID (Firebase Console → Authentication → Google → Web client ID).
# Optional — defaults to this project's auto-created client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Cloud OAuth client → Authorized redirect URIs must include:
#   http://localhost:3000/auth/google/callback
#   https://<your-production-domain>/auth/google/callback
